<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pictures directory -->
    <external-path
        name="pictures"
        path="Pictures/" />

    <!-- DCIM Camera directory -->
    <external-path
        name="camera"
        path="DCIM/Camera/" />

    <!-- App-specific directory -->
    <external-files-path
        name="app_pictures"
        path="Pictures/" />

    <!-- Cache directory for temporary files -->
    <cache-path
        name="cache"
        path="." />
</paths>